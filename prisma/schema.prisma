generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                String    @id @default(cuid())
  source            String
  sourceId          String    @default("unknown")
  collector         String    @default("unknown")
  discoveredVia     String    @default("direct")
  sourceUrl         String
  canonicalUrl      String    @unique
  title             String
  normalizedTitle   String
  companyName       String
  location          String?
  remoteType        String
  salaryMin         Int?
  salaryMax         Int?
  currency          String?
  seniority         String?
  description       String?
  requirements      String?
  stackTags         String[]  @default([])
  geoRestrictions   String[]  @default([])
  postedAt          DateTime?
  discoveredAt      DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  score             Int       @default(0)
  sourceTrustScore  Int
  status            String    @default("new")
  contentHash       String
  notifiedAt        DateTime?
  matchReasons      Json?
  riskFlags         Json?
  recommendedAction String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            JobEvent[]

  @@index([contentHash])
  @@index([companyName])
  @@index([sourceId])
  @@index([collector])
  @@index([discoveredVia])
  @@index([normalizedTitle])
  @@index([score])
  @@index([sourceTrustScore])
  @@index([status])
  @@index([notifiedAt])
  @@index([lastSeenAt])
}

model Company {
  id         String   @id @default(cuid())
  name       String   @unique
  website    String?
  careersUrl String?
  atsType    String?
  priority   Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Recruiter {
  id              String    @id @default(cuid())
  name            String
  companyName     String?
  linkedinUrl     String?
  email           String?
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyName])
  @@index([email])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([eventType])
  @@index([createdAt])
}

model CollectionRun {
  id                String    @id @default(cuid())
  status            String    @default("running")
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  rawItems          Int       @default(0)
  normalizedJobs    Int       @default(0)
  acceptedJobs      Int       @default(0)
  rejectedJobs      Int       @default(0)
  newJobs           Int       @default(0)
  rediscoveredJobs  Int       @default(0)
  highScoringJobs   Int       @default(0)
  notificationsSent Int       @default(0)
  collectorFailures Int       @default(0)
  sourceMetrics     Json?
  errors            Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([startedAt])
  @@index([finishedAt])
}

model DynamicSearchConfig {
  id                  String    @id @default(cuid())
  label               String
  queryText           String
  normalizedQueryText String
  targetEngines       String[]  @default(["google", "bing", "duckduckgo"])
  intervalMinutes     Int       @default(360)
  cronExpression      String?
  isActive            Boolean   @default(true)

  // Enrichment controls
  targetSites         String[]  @default([])
  excludedTerms       String[]  @default([])
  requiredTerms       String[]  @default([])
  locale              String    @default("en-US")
  maxResults          Int       @default(30)

  // Execution metadata
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  failureCount        Int       @default(0)
  lastError           String?
  lastGeneratedDork   String?
  
  // Last execution metrics
  lastItemsCount      Int?
  lastAcceptedCount   Int?
  lastRejectedCount   Int?
  lastNewCount        Int?
  lastRediscoveredCount Int?

  // Audit
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isActive])
  @@index([nextRunAt])
}
