                        "ok",
                        "error"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "unavailable"
                      ]
                    },
                    "uptimeSeconds": {
                      "type": "integer"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "database",
                    "uptimeSeconds",
                    "timestamp"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
